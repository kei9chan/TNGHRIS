{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/hris-sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" } ] },
    { "source": "/manifest.webmanifest", "headers": [ { "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" } ] }
  ],
  "crons": [
    {
      "path": "/api/cron/schedule-compliance",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/approval-reminders",
      "schedule": "0 0 * * 1-5"
    }
  ]
}
