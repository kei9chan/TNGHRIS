{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/schedule-compliance",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/approval-reminders",
      "schedule": "0 0 * * 1-5"
    }
  ]
}
